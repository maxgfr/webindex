{
  "name": "webindex",
  "version": "1.18.6",
  "description": "Zero-dependency web engine: find pages with a local keyless search stack, turn a URL or a file into clean, citable text \u2014 HTML, PDFs through a six-rung ladder ending in OCR, office documents \u2014 and serve it over MCP. One vendorable engine.mjs, CLI + MCP server included. The web-side companion to codeindex.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "main": "scripts/engine.mjs",
  "types": "scripts/engine.d.mts",
  "exports": {
    ".": {
      "types": "./scripts/engine.d.mts",
      "default": "./scripts/engine.mjs"
    }
  },
  "files": [
    "scripts/engine.mjs",
    "scripts/engine.d.mts",
    "scripts/webindex.mjs",
    "src",
    "SKILL.md",
    "references"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:build": "tsup && node scripts/postbuild.mjs && node scripts/check-vendorable.mjs && node scripts/consumer-smoke.mjs && node scripts/verify-bundle.mjs && git diff --exit-code -- scripts/engine.mjs scripts/engine.d.mts scripts/webindex.mjs",
    "verify:vendorable": "node scripts/check-vendorable.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "release": "semantic-release",
    "verify:standalone": "node scripts/consumer-smoke.mjs"
  },
  "keywords": [
    "web-search",
    "retrieval",
    "scraping",
    "pdf-extraction",
    "searxng",
    "firecrawl",
    "mcp",
    "zero-dependency",
    "engine"
  ],
  "license": "MIT",
  "author": "maxgfr",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/webindex"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "bin": {
    "webindex": "scripts/webindex.mjs"
  }
}
